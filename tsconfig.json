{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "rootDir": ".",
    "baseUrl": ".",
    "outDir": "./gen/srv",
    "paths": {
      "#cds-models/*": [
        "@cds-models/*"
      ],
      "#root/*": [
        "./*"
      ]
    }
  }
}